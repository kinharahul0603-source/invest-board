@st.cache_data(ttl=3600)
def optimise(p, rf_, mu_, cov_):
    cfg = PERSONAS[p]
    w0 = np.array([snaps[p]["holdings"][n]["weight"] for n in NAMES])
    cls = np.array([CLASS[n] for n in NAMES])
    cons = [{"type": "eq", "fun": lambda w: w.sum() - 1}]
    for c, (lo, hi) in cfg["bands"].items():
        m = cls == c
        cons.append({"type": "ineq", "fun": lambda w, m=m, lo=lo: w[m].sum() - lo})
        cons.append({"type": "ineq", "fun": lambda w, m=m, hi=hi: hi - w[m].sum()})
    m_, c_ = mu_.reindex(NAMES).values, cov_.reindex(index=NAMES, columns=NAMES).values
    f = lambda w: -(w @ m_ - rf_) / np.sqrt(w @ c_ @ w + 1e-12)
    r = minimize(f, w0, bounds=[(0, MAX_WEIGHT)] * len(NAMES), constraints=cons, method="SLSQP")
    w = r.x if r.success else w0
    return pd.Series(np.clip(w, 0, None) / np.clip(w, 0, None).sum(), index=NAMES)


