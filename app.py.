@st.cache_data(ttl=900, show_spinner="Fetching market data…")
def load_prices():
    tk = [i["ticker"] for i in INSTRUMENTS if i["ticker"]] + [BENCH]
    start = pd.Timestamp.today() - pd.DateOffset(years=LOOKBACK_YEARS)
    df = yf.download(tk, start=start, auto_adjust=False, progress=False)["Close"]
    if isinstance(df, pd.Series):
        df = df.to_frame(tk[0])
    df.index = pd.to_datetime(df.index).tz_localize(None)
    return df.ffill()


@st.cache_data(ttl=3600, show_spinner="Fetching dividends…")
def load_dividends():
    out = {}
    for i in INSTRUMENTS:
        if not i["ticker"]:
            continue
        try:
            s = yf.Ticker(i["ticker"]).dividends
            s.index = pd.to_datetime(s.index).tz_localize(None)
            out[i["name"]] = s[s.index > INVEST_DATE]
        except Exception:
            out[i["name"]] = pd.Series(dtype=float)
    return out


@st.cache_data(ttl=86400)
def load_caps():
    out = {}
    for i in INSTRUMENTS:
        try:
            out[i["name"]] = yf.Ticker(i["ticker"]).fast_info["market_cap"] / 1e7 if i["ticker"] else np.nan
        except Exception:
            out[i["name"]] = np.nan
    return out


