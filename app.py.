def entry_price(name):
    s = prices[name].dropna().loc[INVEST_DATE:]
    return float(s.iloc[0]) if len(s) else float(prices[name].dropna().iloc[-1])


def get_snapshot(persona):
    cfg = PERSONAS[persona]
    if os.path.exists(cfg["file"]):
        snap = json.load(open(cfg["file"]))
        snap["source"] = "repo"
        return snap
    n_cls = pd.Series(CLASS).value_counts()
    holdings = {}
    for i in INSTRUMENTS:
        w = cfg["alloc"][i["cls"]] / n_cls[i["cls"]]
        ep = entry_price(i["name"])
        holdings[i["name"]] = dict(weight=w, entry_price=ep, units=round(w * CORPUS / ep, 4),
                                   entry_date=str(INVEST_DATE.date()))
    snap = dict(persona=persona, created=str(pd.Timestamp.today().date()),
                corpus=CORPUS, holdings=holdings, source="autosave")
    try:
        json.dump(snap, open(cfg["file"], "w"), indent=2)
    except Exception:
        pass
    return snap


