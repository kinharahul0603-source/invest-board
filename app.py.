@st.cache_data(ttl=3600)
def stats(rf, key):
    mu = (rets.mean() * TD).clip(-0.10, 0.35)
    mu[GSEC["name"]] = GSEC["income"]
    vol = rets.std() * np.sqrt(TD)
    cov = rets.cov().fillna(0) * TD
    cov += np.eye(len(cov)) * 1e-8
    beta = rets.apply(lambda c: c.cov(mkt) / mkt.var() if c.name != GSEC["name"] else 0.0)
    return mu, vol, cov, beta


