def card(label, value, sub="", color="#555", cls=""):
    return (f"<div class='card {cls}'><div class='lbl'>{label}</div><div class='val'>{value}</div>"
            f"<div class='sub' style='color:{color}'>{sub}</div></div>")


def cr(x):  return f"₹{x/1e7:.2f} Cr"
def lakh(x): return f"₹{x/1e5:.2f} L"
def sgn(x, f): return ("-" if x < 0 else "") + f(abs(x))


